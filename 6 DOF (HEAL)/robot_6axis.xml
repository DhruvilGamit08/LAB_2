# LAB_2 6-AXIS XML FILE

<mujoco model="6_axis_robot">
  <compiler angle="degree"/>
  <option gravity="0 0 -9.81" timestep="0.002"/>

  <default>
    <joint damping="1.5" armature="0.1"/>
  </default>

  <worldbody>
    <geom type="plane" size="5 5 0.1" rgba="0.9 0.9 0.9 1"/>
    <light pos="0 0 3" dir="0 0 -1"/>

    <!-- Base Link -->
    <body name="base" pos="0 0 0">
      <geom type="cylinder" size="0.1 0.1" rgba="0.2 0.2 0.2 1"/>
      
      <!-- Link 1 (Joint 1: Yaw) -->
      <body name="link1" pos="0 0 0.1">
        <joint name="joint1" axis="0 0 1" range="-180 180"/>
        <geom type="cylinder" size="0.08 0.15" pos="0 0 0.15" rgba="0.8 0.2 0.2 1"/>

        <!-- Link 2 (Joint 2: Pitch) -->
        <body name="link2" pos="0 0 0.3">
          <joint name="joint2" axis="0 1 0" range="-90 90"/>
          <geom type="capsule" size="0.06" fromto="0 0 0 0 0 0.4" rgba="0.2 0.8 0.2 1"/>

          <!-- Link 3 (Joint 3: Pitch) -->
          <body name="link3" pos="0 0 0.4">
            <joint name="joint3" axis="0 1 0" range="-135 135"/>
            <geom type="capsule" size="0.05" fromto="0 0 0 0 0 0.3" rgba="0.2 0.2 0.8 1"/>

            <!-- Link 4 (Joint 4: Roll) -->
            <body name="link4" pos="0 0 0.3">
              <joint name="joint4" axis="1 0 0" range="-180 180"/>
              <geom type="cylinder" size="0.04 0.1" pos="0.1 0 0" quat="0.707 0 0.707 0" rgba="0.8 0.8 0.2 1"/>

              <!-- Link 5 (Joint 5: Pitch) -->
              <body name="link5" pos="0.2 0 0">
                <joint name="joint5" axis="0 1 0" range="-120 120"/>
                <geom type="sphere" size="0.04" rgba="0.8 0.2 0.8 1"/>

                <!-- Link 6 (Joint 6: Roll / End Effector) -->
                <body name="link6" pos="0 0 0">
                  <joint name="joint6" axis="1 0 0" range="-360 360"/>
                  <geom type="cylinder" size="0.02 0.05" pos="0.05 0 0" quat="0.707 0 0.707 0" rgba="0.2 0.8 0.8 1"/>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <!-- Stabilized Actuators -->
  <actuator>
    <position name="a_joint1" joint="joint1" kp="200" damping="20"/>
    <position name="a_joint2" joint="joint2" kp="300" damping="30"/>
    <position name="a_joint3" joint="joint3" kp="200" damping="20"/>
    <position name="a_joint4" joint="joint4" kp="100" damping="10"/>
    <position name="a_joint5" joint="joint5" kp="50" damping="5"/>
    <position name="a_joint6" joint="joint6" kp="20" damping="2"/>
  </actuator>
</mujoco>
